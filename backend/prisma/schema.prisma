generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ... resto do seu schema

// ===== USER MODEL =====
model User {
  id                String       @id @default(uuid())
  email             String       @unique
  name              String
  passwordHash      String       // Argon2id hash
  passwordSalt      String       // Unique salt per user
  refreshTokenHash  String?      // Hashed refresh token (single device)
  
  // Limits & Usage
  documentsCount    Int          @default(0)
  documentsLimit    Int          @default(5)
  tokensUsed        Int          @default(0)
  tokensLimit       Int          @default(10000)
  
  // Audit
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  
  // Relations
  documents         Document[]
  
  // Indexes
  @@index([email])
  @@map("users")
}

// ===== DOCUMENT MODEL =====
model Document {
  id              String             @id @default(uuid())
  userId          String
  filename        String             // Generated unique filename
  originalName    String             // User's original filename
  mimeType        String             // image/png, image/jpeg, application/pdf
  fileSize        Int                // Bytes
  s3Key           String             // S3 object key
  s3ThumbnailKey  String?            // Thumbnail key (for images)
  
  // OCR Processing
  status          DocumentStatus     @default(PROCESSING)
  extractedText   String?            @db.Text
  ocrCompletedAt  DateTime?
  errorMessage    String?
  
  // Audit
  uploadedAt      DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  
  // Relations
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  llmInteractions LLMInteraction[]
  
  // Indexes
  @@index([userId, uploadedAt(sort: Desc)])
  @@index([status])
  @@map("documents")
}

// ===== DOCUMENT STATUS ENUM =====
enum DocumentStatus {
  PROCESSING
  COMPLETED
  ERROR
}

// ===== LLM INTERACTION MODEL =====
model LLMInteraction {
  id            String    @id @default(uuid())
  documentId    String
  userId        String    // Denormalized for faster queries
  question      String    @db.Text
  answer        String    @db.Text
  tokensUsed    Int
  
  // Audit
  createdAt     DateTime  @default(now())
  
  // Relations
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  // Indexes
  @@index([documentId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("llm_interactions")
}