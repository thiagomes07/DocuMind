# ===== APPLICATION =====
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ===== DATABASE =====
DATABASE_URL=postgresql://ocruser:ocrpass123@localhost:5432/ocr_db

# Database Connection Pool (optional)
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_QUERY_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000
DB_LOG_QUERIES=false

# ===== JWT & SECURITY =====
# IMPORTANT: Generate strong random secrets for production
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Pepper (global salt)
PASSWORD_PEPPER=your-super-secret-pepper-change-in-production

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET=ocr-app-bucket
S3_PREFIX=dev

# ===== AWS BEDROCK LLM =====
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_REQUEST_TIMEOUT=30000
MAX_CONTEXT_LENGTH=100000

# ===== USER LIMITS =====
MAX_DOCUMENTS_PER_USER=5
MAX_TOKENS_PER_USER=10000
MAX_FILE_SIZE_MB=10
MAX_QUESTION_LENGTH=500

# ===== RATE LIMITING =====
# These are defaults in app.config.ts, override if needed
# THROTTLE_TTL=60000
# THROTTLE_LIMIT=30
# UPLOAD_THROTTLE_TTL=600000
# UPLOAD_THROTTLE_LIMIT=3