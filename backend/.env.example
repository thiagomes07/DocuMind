# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://ocruser:ocrpass123@localhost:5432/ocr_db

# JWT & Security (GERAR VALORES ALEATÓRIOS FORTES)
JWT_ACCESS_SECRET=your-super-secret-access-key-change-this-256-bits
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-256-bits
PASSWORD_PEPPER=your-super-secret-pepper-change-this-256-bits

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET=ocr-app-bucket
S3_PREFIX=dev

# AWS Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Limites
MAX_DOCUMENTS_PER_USER=5
MAX_TOKENS_PER_USER=10000
MAX_FILE_SIZE_MB=10