# ===== APPLICATION =====
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ===== DATABASE =====
DATABASE_URL=postgresql://ocruser:ocrpass123@postgres:5432/ocr_db

# ===== JWT & SECURITY =====
# Generate strong secrets: openssl rand -base64 32
JWT_ACCESS_SECRET=your-super-secret-access-token-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-change-this-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password pepper (global secret for password hashing)
PASSWORD_PEPPER=your-super-secret-pepper-change-this-in-production

# ===== AWS CREDENTIALS =====
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ===== S3 STORAGE =====
S3_BUCKET=your-bucket-name
S3_PREFIX=dev
S3_SIGNED_URL_EXPIRATION=3600

# ===== AWS BEDROCK (LLM) =====
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_REQUEST_TIMEOUT=30000

# ===== USER LIMITS =====
MAX_DOCUMENTS_PER_USER=5
MAX_TOKENS_PER_USER=10000
MAX_FILE_SIZE_MB=10

# ===== LLM CONFIGURATION =====
MAX_QUESTION_LENGTH=500
MAX_CONTEXT_LENGTH=100000

# ===== DATABASE CONFIGURATION (Optional) =====
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_QUERY_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000
DB_LOG_QUERIES=false